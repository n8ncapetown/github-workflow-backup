        "assignments": {
          "assignments": [
            {
              "id": "wf-id",
              "name": "workflowId",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "wf-name",
              "name": "workflowName",
              "value": "={{ $json.name }}",
              "type": "string"
            },
            {
              "id": "file-path",
              "name": "filePath",
              "value": "=workflows/{{ ($json.name || \"untitled\").replace(/[^a-zA-Z0-9 _-]/g, \"\").trim().replace(/\\s+/g, \"-\") }}_{{ $json.id }}.json",
              "type": "string"
            },
            {
              "id": "file-content",
              "name": "fileContent",
              "value": "={{ JSON.stringify($json, null, 2) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "69213f76-359e-4f56-a164-b9fcf16de126",
