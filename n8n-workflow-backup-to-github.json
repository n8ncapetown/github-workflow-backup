            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Loop Over Workflows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Backup in GitHub": {
      "main": [
        [
          {
            "node": "Loop Over Workflows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Backup in GitHub": {
      "main": [
        [
          {
            "node": "Loop Over Workflows",
